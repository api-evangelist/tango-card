{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tango RaaS Accounts Orders API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tangocard.com/raas/v2/orders",
            "params": [
              {
                "name": "accountIdentifier",
                "value": "",
                "type": "query",
                "description": "Filter by account identifier"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Filter orders created after this date"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "Filter orders created before this date"
              },
              {
                "name": "elementsPerBlock",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              }
            ]
          },
          "docs": "Retrieve a list of reward orders."
        },
        {
          "info": {
            "name": "Create an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tangocard.com/raas/v2/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Place a new reward order to send a gift card or incentive."
        },
        {
          "info": {
            "name": "Get an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tangocard.com/raas/v2/orders/:referenceOrderID",
            "params": [
              {
                "name": "referenceOrderID",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a specific order by reference order ID."
        },
        {
          "info": {
            "name": "Resend an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tangocard.com/raas/v2/orders/:referenceOrderID/resends",
            "params": [
              {
                "name": "referenceOrderID",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Resend the reward delivery for a specific order."
        }
      ]
    }
  ],
  "bundled": true
}