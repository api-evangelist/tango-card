{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tango RaaS Accounts Countries & Currencies API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Countries & Currencies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List reward countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tangocard.com/raas/v2/rewardCountries"
          },
          "docs": "Retrieve a list of all countries where rewards are available."
        }
      ]
    }
  ],
  "bundled": true
}